generator client {
  provider = "prisma-client-js"
  output   = "../prisma-payments-database/payments-database-client-types"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://content_owner:npg_PxdXUC3cBE2V@ep-wandering-silence-a5xf8fxt-pooler.us-east-2.aws.neon.tech/content?sslmode=require"
}

model InformatioPayYoo {
  payid              Int       @id @default(autoincrement())
  payIdYoo           String    @unique
  status             String
  amount             String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  IPaymentMethodData String
  userId             Int       @unique
  autoPay            Boolean
  subscriptionStart  DateTime? // Дата начала текущей подписки
  subscriptionEnd    DateTime? // Дата окончания текущей подписки
  renewalDate        DateTime? // Дата продления (если было)
  subscriptionTerm   String? // Период подписки (месяц/год)

  isRenewed Boolean? @default(false)

  @@map("InformatioPayYoo")
}

model paymentsUser {
  payid              Int       @id @default(autoincrement())
  payIdYoo           String    @unique
  status             String
  amount             String
  subscriptionStart  DateTime? // Дата начала текущей подписки
  subscriptionTerm   String? // Период подписки (месяц/год)
  userId             Int       @unique
  IPaymentMethodData String

  @@map("paymentsUser")
}
